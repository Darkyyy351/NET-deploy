[Unit]
Description=NET CM5 fan control safety helper
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/lib/net/net-fan-control.py
Restart=always
RestartSec=1
RuntimeDirectory=net-fan-control
RuntimeDirectoryMode=0755
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/sys/class/thermal/thermal_zone0/policy /sys/class/thermal/cooling_device0/cur_state
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
